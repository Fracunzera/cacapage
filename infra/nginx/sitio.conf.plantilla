# Plantilla de sitio para un nginx que ya existe en el VPS (docs/despliegue.md).
# Se completa con sed: __DOMINIO__ y __PUERTO__. El HTTPS lo agrega certbot.
# Sin log de acceso (PRIVACY.md P-19).
server {
	listen 80;
	listen [::]:80;
	server_name __DOMINIO__;

	access_log off;
	client_max_body_size 1m;
	__CABECERAS__

	location / {
		proxy_pass http://127.0.0.1:__PUERTO__;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}
