# Configuración por entorno. Ver DESIGN.md §15.
#
# ORIGEN_PUBLICO es el ÚNICO lugar donde aparece el dominio. De acá salen el
# RP ID de WebAuthn (solo en producción), CORS, los links y el remitente de los
# mails, el manifest de la PWA, el subject de VAPID, las URLs de OpenGraph y el
# Caddyfile. Un chequeo de CI falla si el dominio aparece escrito en otro lado.
ORIGEN_PUBLICO=https://caca.blucaro.site

# prueba | produccion
# Con "prueba": sin passkeys (no hay forma de encenderlas), banner de entorno de
# prueba, X-Robots-Tag noindex, sin sitemap ni /.well-known. Cuentas descartables.
ENTORNO=prueba

# Secretos: distintos en cada entorno. Nunca en el repo.
PIMIENTA_MAIL=
SECRETO_SESIONES=
VAPID_PUBLICA=
VAPID_PRIVADA=
LLAVE_CIFRADO_REPOSO=
DATABASE_URL=
PROVEEDOR_MAIL_API_KEY=
