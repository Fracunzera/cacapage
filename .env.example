# Configuración del VPS (docs/despliegue.md). Copiar a .env y completar.
# Cada dominio aparece una sola vez, acá. Nunca subir .env al repo.

# Sitio real (ENTORNO=produccion): passkeys, cuentas reales.
ORIGEN_PUBLICO=https://dondecague.com.ar
# Sitio de prueba (ENTORNO=prueba): relevamiento, sin passkeys, cuentas descartables.
ORIGEN_PRUEBA=https://caca.blucaro.site

# Puertos locales de las apps (solo 127.0.0.1); el proxy (nginx o Caddy) apunta acá.
PUERTO_WEB=3101
PUERTO_PRUEBA=3102

# Generar cada uno con: openssl rand -hex 32
POSTGRES_PASSWORD=
PIMIENTA_MAIL=
PIMIENTA_MAIL_PRUEBA=

# Mail para los links de entrada.
#   desactivado: solo passkeys (para arrancar sin proveedor de mail).
#   smtp: con proveedor; SMTP_URL=smtps://usuario:clave@servidor:465
#   consola: el link se imprime en el log (solo prueba).
MAIL_MODO=desactivado
MAIL_MODO_PRUEBA=consola
SMTP_URL=

# Baños de OpenStreetMap: cada sitio los importa solo, una vez por semana, por
# Overpass (solo lectura, ADR 0001). "no" para apagarlo.
OSM_IMPORTAR=si
OSM_IMPORTAR_PRUEBA=si

# Entrar con Google (opcional; docs/despliegue.md, "Entrar con Google").
# Vacío = el botón no aparece. El mismo cliente sirve para los dos sitios.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Buscador de direcciones (opcional). Por defecto, el Nominatim público de
# OpenStreetMap (un pedido por segundo como mucho). Para uno propio, su URL /search.
# NOMINATIM_URL=
